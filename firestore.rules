rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function myEmail() { return request.auth.token.email; }
    function isOwner() {
      return request.auth != null && request.auth.token.email == 't0504154423@gmail.com';
    }
    function adminsDoc() { return get(/databases/$(database)/documents/meta/admins).data; }
    // כל מנהל (ראשי או משני) – קריאה בלבד, אלא אם יש לו הרשאה
    function isAdmin() {
      return isOwner() || (request.auth != null && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/meta/admins) && myEmail() in adminsDoc().emails);
    }
    function can(p) {
      return isOwner() || (isAdmin() && p in adminsDoc().get('perms', {}).get(myEmail(), []));
    }
    function isEmployee() {
      return request.auth != null && request.auth.token.role == 'employee';
    }
    function isEmployeeId(id) {
      return isEmployee() && request.auth.uid == id;
    }
    function lockedMonths() {
      return exists(/databases/$(database)/documents/meta/locks)
        ? get(/databases/$(database)/documents/meta/locks).data.list : [];
    }

    // כל מנהל קורא הכול; כתיבה כללית – רק המנהל הראשי
    match /{document=**} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }
    // הרשאות של מנהל משני
    match /hours/{empId} {
      allow write: if can('hours');
      allow read: if isEmployeeId(empId);
      allow create: if isEmployeeId(empId);
      allow update: if isEmployeeId(empId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(lockedMonths());
    }
    match /meta/locks {
      allow write: if can('hours');
      allow read: if isEmployee();
    }
    match /settings/{empId} {
      allow write: if can('timeoff');
      allow read, write: if isEmployeeId(empId);
    }
    match /meta/employees {
      allow write: if can('employees') || can('timeoff') || can('pay');
    }
    match /meta/trash {
      allow write: if can('employees');
    }
    match /auditLog/{empId}/items/{item} {
      allow create: if isAdmin() || isEmployeeId(empId);
    }
    match /chats/{chatId} {
      allow read, write: if isAdmin();
      allow read, write: if isEmployee() && (chatId == 'team' || request.auth.uid in chatId.split('__'));
    }
    match /tasks/{empId} {
      allow write: if can('employees');
      allow read, write: if isEmployeeId(empId);
    }
    match /meta/requests {
      allow write: if can('requests');
      allow read, write: if isEmployee();
    }
    match /voiceMessages/{id} {
      allow write: if can('requests');
      allow read, write: if isEmployee();
    }
    match /meta/announcement {
      allow read: if isEmployee();
    }
    match /meta/appSettings {
      allow read: if isEmployee();
    }
    match /meta/contact {
      allow read: if isEmployee();
    }
  }
}
