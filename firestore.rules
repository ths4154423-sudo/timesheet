rules_version = '2';
// כללי האבטחה של Firebase (Firestore) לאתר שעון הנוכחות.
// הקובץ הזה לא מופעל אוטומטית: מעתיקים אותו ל-Firebase Console → Firestore → Rules → Publish.
// אימייל המנהל: t0504154423@gmail.com (להוספת מנהל נוסף - מוסיפים אימייל לרשימה, מופרד בפסיק).
service cloud.firestore {
  match /databases/{database}/documents {

    // מנהל: מחובר עם אימייל וסיסמה, ורק מהאימיילים שברשימה
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['t0504154423@gmail.com'];
    }
    // עובד: נכנס עם קוד אישי דרך הגשר (טוקן עם role=employee)
    function isEmployee() {
      return request.auth != null && request.auth.token.role == 'employee';
    }
    function isEmployeeId(id) {
      return isEmployee() && request.auth.uid == id;
    }

    // מנהל – גישה מלאה לכל הנתונים
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // עובד – רק השעות וההגדרות של עצמו
    match /hours/{empId} {
      allow read, write: if isEmployeeId(empId);
    }
    match /settings/{empId} {
      allow read, write: if isEmployeeId(empId);
    }

    // בקשות לעובדים ולמנהל, והודעות קוליות (כמו שהאתר עובד היום)
    match /meta/requests {
      allow read, write: if isEmployee();
    }
    match /voiceMessages/{id} {
      allow read, write: if isEmployee();
    }

    // הודעה כללית, הגדרות ופרטי קשר – עובדים רק קוראים
    match /meta/announcement {
      allow read: if isEmployee();
    }
    match /meta/appSettings {
      allow read: if isEmployee();
    }
    match /meta/contact {
      allow read: if isEmployee();
    }

    // meta/employees (שמות, טלפונים וקודים אישיים) – למנהל בלבד.
    // הגשר ניגש אליו עם חשבון שירות, שלא כפוף לכללים האלה.
  }
}
