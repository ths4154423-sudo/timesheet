rules_version = '2';
// כללי האבטחה של Firebase (Firestore) לאתר שעון הנוכחות.
// מעתיקים ל-Firebase Console → Firestore → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // מנהל: המנהל הראשי, או אימייל שהוסף ברשימת המנהלים באתר (meta/admins)
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null && (
        request.auth.token.email == 't0504154423@gmail.com' ||
        (exists(/databases/$(database)/documents/meta/admins) &&
         request.auth.token.email in get(/databases/$(database)/documents/meta/admins).data.emails));
    }
    function isEmployee() {
      return request.auth != null && request.auth.token.role == 'employee';
    }
    function isEmployeeId(id) {
      return isEmployee() && request.auth.uid == id;
    }
    // חודשים נעולים (meta/locks.list) – עובד לא יכול לשנות בהם
    function lockedMonths() {
      return exists(/databases/$(database)/documents/meta/locks)
        ? get(/databases/$(database)/documents/meta/locks).data.list : [];
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
    match /hours/{empId} {
      allow read: if isEmployeeId(empId);
      allow create: if isEmployeeId(empId);
      allow update: if isEmployeeId(empId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(lockedMonths());
    }
    match /settings/{empId} {
      allow read, write: if isEmployeeId(empId);
    }
    // יומן שינויים: עובד יכול רק להוסיף שורות על עצמו, לא לשנות או למחוק
    match /auditLog/{empId}/items/{item} {
      allow create: if isEmployeeId(empId);
    }
    match /meta/locks {
      allow read: if isEmployee();
    }
    match /meta/requests {
      allow read, write: if isEmployee();
    }
    match /voiceMessages/{id} {
      allow read, write: if isEmployee();
    }
    match /meta/announcement {
      allow read: if isEmployee();
    }
    match /meta/appSettings {
      allow read: if isEmployee();
    }
    match /meta/contact {
      allow read: if isEmployee();
    }
  }
}
